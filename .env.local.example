# Copy to .env.local and fill in. See README.md for details on demo mode
# vs. live mode for the database and email integrations.

GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL_ID=gemini-flash-latest

# Leave blank to run in local JSON-file demo mode.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Leave blank to run in simulated-send mode.
RESEND_API_KEY=
SENDER_EMAIL=
SENDER_NAME=
